<?xml version="1.0" encoding="utf-8"?>
<!-- 标签页/历史/书签 通用 Overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_safe_margin_h"
        android:paddingEnd="@dimen/tv_safe_margin_h"
        android:paddingTop="@dimen/tv_safe_margin_v"
        android:paddingBottom="@dimen/tv_safe_margin_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextTitle"
                android:textSize="24sp" />

            <ImageButton
                android:id="@+id/btn_add_tab"
                style="@style/WidgetTvFoxIconButton"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/tab_new"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_close_overlay"
                style="@style/WidgetTvFoxIconButton"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/tab_close" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/overlay_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/overlay_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
