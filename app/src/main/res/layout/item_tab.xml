<?xml version="1.0" encoding="utf-8"?>
<!-- 标签页缩略图卡片 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tab_thumb_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tab_card"
        android:layout_width="@dimen/tab_thumb_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_thumb_height">

            <View
                android:id="@+id/tab_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_dark" />

            <TextView
                android:id="@+id/tab_title_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="8dp"
                android:background="#99000000"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_close_tab"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end|top"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_icon_button"
        android:tint="@color/text_primary"
        android:focusable="true"
        android:contentDescription="@string/tab_close" />
</FrameLayout>
